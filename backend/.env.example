# Backend environment. Copy to .env and fill in.
# The app runs with SQLite by default; set DATABASE_URL for SQL Server.

# SQL Server (via docker-compose.yml at repo root):
# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/social_analyzer?driver=ODBC+Driver+18+for+SQL+Server

# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./analyzer.db

# Required for encrypting stored OAuth tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Instagram OAuth (Instagram Login flow) — from Meta App Dashboard > Business login settings.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/oauth-callback
